---
import Wordmark from '../Wordmark.astro';
// The scattered cards of today's loyalty, and the one list they become.
const pieces = [
  { id: 'punch', kind: 'כרטיס ניקוב', name: 'בית הקפה', row: 'קפה פינה', val: '7/10' },
  { id: 'club', kind: 'כרטיס מועדון', name: 'המעדנייה', row: 'מעדניית השוק', val: '3/8' },
  { id: 'app', kind: 'אפליקציה נפרדת', name: 'המסעדה', row: 'זעתר', val: '4/6' },
  { id: 'paper', kind: 'פתק חותמות', name: 'המאפייה', row: 'מאפיית הגפן', val: '5/8' },
  { id: 'code', kind: 'קוד הנחה בקבלה', name: 'חנות הספרים', row: 'דפדוף', val: '120 נק׳' },
];
---
<section class="problem" id="problem" aria-labelledby="problem-title" data-converge>
  <div class="problem__stage">
    <div class="problem__copy">
      <h2 id="problem-title" class="head" data-reveal>
        <span class="line">כל עסק עם כרטיס אחר.</span>
        <span class="line">למה בעצם?</span>
      </h2>
      <div class="problem__text" data-reveal style="--i:1">
        <p>כרטיס ניקוב מנייר בבית הקפה, כרטיס פלסטיק במעדנייה, אפליקציה נפרדת למסעדה וקוד הנחה שהודפס על קבלה. כל עסק בונה מועדון משלו, וכל לקוח צריך לזכור איפה כל אחד מהם נמצא.</p>
        <p>הכרטיסים נשכחים בבית, האפליקציות נמחקות כדי לפנות מקום, והחותמת השמינית הולכת לאיבוד יחד עם הארנק הישן.</p>
        <p class="problem__answer">ב-Perko הם נאספים לרשימה אחת, וכל עסק שומר על הכללים שלו.</p>
      </div>
    </div>

    <div class="problem__visual" data-ui aria-hidden="true">
      <div class="problem__pile">
        {pieces.map((p) => (
          <div class:list={['frag', `frag--${p.id}`]} data-frag={p.id}>
            {p.id === 'punch' && (
              <>
                <span class="frag__kind">{p.kind}</span>
                <b class="frag__name">{p.name}</b>
                <span class="frag__holes">{Array.from({ length: 10 }, (_, i) => <i class:list={{ on: i < 7 }}></i>)}</span>
              </>
            )}
            {p.id === 'club' && (
              <>
                <b class="frag__name">{p.name}</b>
                <span class="frag__kind">{p.kind} · חבר מס׳ 004817</span>
                <span class="frag__chip"></span>
                <span class="frag__bars">{Array.from({ length: 22 }, (_, i) => <i style={`--w:${(i * 7) % 3 + 1}`}></i>)}</span>
              </>
            )}
            {p.id === 'app' && (
              <>
                <span class="frag__icon"></span>
                <span><b class="frag__name">{p.name}</b><span class="frag__kind">{p.kind}<span class="frag__extra"> · הרשמה, סיסמה, עדכונים</span></span></span>
              </>
            )}
            {p.id === 'paper' && (
              <>
                <b class="frag__name">{p.name}</b>
                <span class="frag__kind">{p.kind}</span>
                <span class="frag__ticks">{Array.from({ length: 8 }, (_, i) => <i class:list={{ on: i < 5 }}></i>)}</span>
              </>
            )}
            {p.id === 'code' && (
              <>
                <span class="frag__kind">{p.kind}</span>
                <b class="frag__name">BOOK-15</b>
                <span class="frag__kind">{p.name} · בתוקף עד סוף החודש</span>
              </>
            )}
          </div>
        ))}
      </div>

      <div class="wallet">
        <div class="wallet__head">
          <Wordmark label={false} class="wallet__mark" />
          <span>5 כרטיסים</span>
        </div>
        <ul class="wallet__rows">
          {pieces.map((p, i) => (
            <li class="wallet__row" data-row={p.id} style={`--i:${i}`}>
              <span class="wallet__dot"></span>
              <b>{p.row}</b>
              <span>{p.val}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .problem { --p: 0; height: 210svh; margin-top: var(--gap-section); }
  .problem__stage {
    position: sticky; top: 68px; height: calc(100svh - 68px); min-height: 620px;
    width: min(100% - 2 * var(--m), var(--max)); margin-inline: auto;
    display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 5vw, 96px); align-items: center;
  }
  .problem__text { margin-top: 32px; display: grid; gap: 18px; max-width: 46ch; }
  .problem__answer { font-weight: 700; color: var(--ink); font-size: var(--t-lead); line-height: 1.4; max-width: 30ch; }

  .problem__visual {
    position: relative; height: min(640px, calc(100svh - 140px)); border-radius: var(--radius);
    background: var(--ink); overflow: hidden;
  }
  .problem__pile { position: absolute; inset: 0; }
  .frag {
    position: absolute; border-radius: 18px; padding: 18px 20px; display: grid; gap: 6px; align-content: start;
    font-size: 15px; line-height: 1.3; color: var(--ink);
    --tx: 0px; --ty: 0px; --r: 0deg;
    transform: translate(calc(var(--tx) * var(--p)), calc(var(--ty) * var(--p))) rotate(calc(var(--r) * (1 - var(--p)))) scale(calc(1 - var(--p) * 0.55));
    opacity: calc(1 - max(0, var(--p) - 0.55) * 2.6);
  }
  .frag__name { font-size: 18px; font-weight: 800; letter-spacing: -0.01em; }
  .frag__kind { color: var(--slate); font-size: 15px; }

  .frag--punch { width: 280px; background: var(--paper); top: 8%; right: 7%; --r: -5deg; }
  .frag__holes { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin-top: 10px; }
  .frag__holes i { aspect-ratio: 1; border-radius: 50%; background: var(--pale-strong); }
  .frag__holes i.on { background: var(--ink); box-shadow: inset 0 2px 3px rgba(0,0,0,0.3); } /* taste-skill-ignore: punched hole in a data-ui drawing */

  .frag--club { width: 290px; height: 178px; background: var(--ink-raised); color: var(--paper); box-shadow: inset 0 0 0 1.5px rgba(248,248,244,0.14); top: 14%; left: 8%; --r: 6deg; }
  .frag--club .frag__kind { color: var(--slate-on-ink); }
  .frag__chip { width: 38px; height: 28px; border-radius: 6px; background: var(--slate-on-ink); margin-top: 10px; }
  .frag__bars { position: absolute; bottom: 18px; left: 20px; display: flex; gap: 2px; height: 26px; }
  .frag__bars i { width: calc(var(--w) * 2px); background: var(--white); opacity: 0.85; }

  .frag--app { width: 300px; background: var(--white); grid-template-columns: auto 1fr; align-items: center; gap: 14px; top: 47%; right: 14%; --r: 3deg; }
  .frag__icon { width: 52px; height: 52px; border-radius: 14px; background: var(--ink); }

  .frag--paper { width: 210px; background: var(--paper); top: 60%; left: 12%; --r: -8deg; border-radius: 6px; }
  .frag__ticks { display: flex; gap: 8px; margin-top: 8px; }
  .frag__ticks i { width: 16px; height: 16px; border-radius: 50%; background: var(--pale); }
  .frag__ticks i.on { background: var(--ink); }

  .frag--code { width: 230px; background: var(--paper); bottom: 6%; right: 36%; --r: 4deg; border-radius: 6px; }
  .frag--code .frag__name { letter-spacing: 0.04em; direction: ltr; text-align: right; }

  .wallet {
    position: absolute; left: 50%; top: 50%; width: min(400px, 82%);
    transform: translate(-50%, calc(-50% + (1 - var(--p)) * 40px));
    background: var(--lime); border-radius: 26px; padding: 22px 22px 14px;
    opacity: clamp(0, (var(--p) - 0.45) * 3, 1);
  }
  .wallet__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; color: var(--muted); font-size: 15px; }
  .wallet__mark { font-size: 26px; }
  .wallet__rows { display: grid; gap: 6px; }
  .wallet__row {
    display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center;
    background: var(--paper); border-radius: 16px; padding: 14px 16px; font-size: 18px;
    font-variant-numeric: tabular-nums;
    opacity: clamp(0, (var(--p) - 0.55 - var(--i) * 0.05) * 6, 1);
    transform: translateY(calc((1 - clamp(0, (var(--p) - 0.55 - var(--i) * 0.05) * 6, 1)) * 12px));
  }
  .wallet__row span:last-child { color: var(--slate); }
  .wallet__dot { width: 14px; height: 14px; border-radius: 50%; background: var(--accent); }

  /* Without script or with reduced motion: the finished state, plainly stacked. */
  :global(html:not(.js)) .problem, .problem.is-static { height: auto; --p: 1; }
  :global(html:not(.js)) .problem__stage, .problem.is-static .problem__stage { position: static; height: auto; min-height: 0; }
  @media (prefers-reduced-motion: reduce) {
    .problem { height: auto; --p: 1; }
    .problem__stage { position: static; height: auto; min-height: 0; }
  }

  @media (max-width: 900px) {
    .problem { height: 200svh; }
    .problem__stage { grid-template-columns: 1fr; align-content: start; gap: 20px; padding-top: 24px; min-height: 0; }
    .problem__text { margin-top: 16px; gap: 10px; font-size: 15px; }
    .problem__text p:nth-child(2) { display: none; }
    .problem__answer { font-size: 18px; }
    .problem__visual { height: auto; aspect-ratio: 1 / 1.02; max-height: 52svh; width: 100%; }
    .frag { transform-origin: center; padding: 12px 14px; font-size: 13px; }
    .frag__name { font-size: 15px; }
    .frag__kind { font-size: 13px; }
    .frag--app .frag__extra { display: none; }
    .frag--punch { width: 190px; right: 4%; top: 5%; }
    .frag__holes { gap: 5px; margin-top: 4px; }
    .frag--club { width: 190px; height: 118px; left: 3%; top: 10%; }
    .frag__bars { height: 16px; bottom: 12px; left: 14px; }
    .frag__chip { width: 28px; height: 20px; margin-top: 4px; }
    .frag--app { width: 210px; right: 6%; top: 47%; gap: 10px; }
    .frag__icon { width: 36px; height: 36px; border-radius: 10px; }
    .frag--paper { width: 150px; left: 4%; top: 62%; }
    .frag--code { width: 160px; right: 30%; bottom: 4%; }
    .wallet { padding: 16px 14px 10px; width: 88%; }
    .wallet__row { padding: 10px 12px; font-size: 15px; }
    .wallet__mark { font-size: 22px; }
  }
  @media (max-width: 900px) and (prefers-reduced-motion: reduce) {
    .problem__text p:nth-child(2) { display: block; }
  }
</style>
