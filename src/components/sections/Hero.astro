---
import Phone from '../Phone.astro';
import QrGlyph from '../ui/QrGlyph.astro';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__copy">
    <div class="hero__text">
      <h1 id="hero-title" class="display hero__title">
        <span class="line">כל ההטבות שלך.</span>
        <span class="line">מקום אחד.</span>
      </h1>
      <p class="lead hero__sub">
        צוברים חותמות, מגלים עסקים חדשים ומממשים הטבות, בלי להסתבך עם עשרות כרטיסי מועדון.
      </p>
      <div class="hero__actions">
        <a class="btn hero__cta" href="#join">
          הצטרפו בחינם
          <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6-6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="text-link" href="#how">גלו איך זה עובד</a>
      </div>
    </div>
    <p class="hero__status small">
      <span class="hero__dot" aria-hidden="true"></span>
      <span><b>Perko בגישה מוקדמת.</b> עסקים מצטרפים עכשיו בחינם, בלי התחייבות לתשלום.</span>
    </p>
  </div>

  <div class="hero__stage on-ink">
    <div class="hero__scene">
      <div class="plane plane--photo" data-depth="-0.05" aria-hidden="true">
        <img src="/img/mahane-yehuda-market-5101386538.webp" width="1400" height="1046" alt="" loading="lazy" decoding="async" />
      </div>
      <div class="plane plane--disc" data-depth="-0.12" aria-hidden="true"></div>
      <Phone class="hero__phone" label="צילום מסך הבית באפליקציית Perko: כרטיס קפה עם 9 מתוך 10 חותמות, כרטיס מסעדה עם 4 מתוך 6, מועדון קוראים עם 120 נקודות, ועסקים משתתפים שעוד לא בארנק">
        <img class="phone__shot" src="/img/app/home.webp" width="780" height="1600" alt="" fetchpriority="high" decoding="async" />
      </Phone>
      <div class="hero__toast" data-ui data-depth="0.2" aria-hidden="true">
        <span class="hero__toast-dot"><svg viewBox="0 0 24 24"><path d="M6 12.5l4 4L18 8" fill="none" stroke="#11130F" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <span><b>נוספה חותמת</b><span>קפה פינה · 9 מתוך 10</span></span>
      </div>
      <div class="hero__qr" data-ui data-depth="0.14" aria-hidden="true">
        <QrGlyph class="hero__qr-glyph" />
        <span>סורקים בקופה,<br />החותמת נכנסת לכרטיס</span>
      </div>
    </div>
    <p class="hero__bar small">
      <span>צילום מסך מהאפליקציה</span>
      <span>שמות העסקים לדוגמה</span>
    </p>
  </div>
</section>

<style>
  .hero {
    display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
    padding: 0 12px 12px;
    min-height: calc(100svh - 68px);
  }
  .hero__copy {
    background: var(--lime); border-radius: var(--radius);
    padding: clamp(32px, 5vw, 80px) clamp(28px, 4.4vw, 72px) 32px;
    display: flex; flex-direction: column; justify-content: space-between; gap: 40px;
  }
  .hero__text { margin-block: auto; padding-top: 4vh; }
  .hero__title { font-size: min(var(--t-display), calc((50vw - 150px) / 7)); }
  .hero__title .line { white-space: nowrap; }
  .hero__sub { margin-top: 36px; max-width: 32ch; }
  .hero__actions { margin-top: 40px; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; }
  .hero__cta { min-height: 60px; padding: 0 32px; font-size: 18px; }
  .hero__status { display: flex; gap: 12px; align-items: baseline; max-width: 46ch; }
  .hero__dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); flex: none; transform: translateY(1px); }

  .hero__stage {
    position: relative; background: var(--ink); border-radius: var(--radius); overflow: hidden;
    display: flex; flex-direction: column; min-height: 640px;
  }
  .hero__scene { flex: 1; position: relative; display: grid; place-items: center; padding: 48px 24px 32px; }
  .hero__phone { width: clamp(260px, min(23vw, calc((100svh - 230px) * 0.47)), 340px); }
  .hero__toast, .hero__qr {
    position: absolute; background: var(--white); color: var(--ink); border-radius: 20px;
    box-shadow: 0 24px 48px -20px rgba(0, 0, 0, 0.6); /* taste-skill-ignore: floating app overlays */
  }
  .hero__toast {
    top: 44%; left: calc(50% - clamp(260px, min(23vw, calc((100svh - 230px) * 0.47)), 340px) / 2 - 88px);
    display: flex; align-items: center; gap: 12px; padding: 14px 18px 14px 22px; font-size: 15px; line-height: 1.3;
  }
  .hero__toast > span:last-child { display: grid; }
  .hero__toast b { font-size: 15px; }
  .hero__toast-dot { width: 30px; height: 30px; border-radius: 50%; background: var(--lime); flex: none; display: grid; place-items: center; }
  .hero__toast-dot svg { width: 18px; height: 18px; }
  .hero__qr {
    bottom: 9%; right: calc(50% - clamp(260px, min(23vw, calc((100svh - 230px) * 0.47)), 340px) / 2 - 76px);
    display: flex; align-items: center; gap: 14px; padding: 14px 16px; font-size: 15px; line-height: 1.35; font-weight: 600; white-space: nowrap;
  }
  .hero__qr-glyph { width: 56px; height: 56px; color: var(--ink); }
  /* Depth planes. Each one moves at its own rate on scroll (see depth.ts), so the stamp sits furthest back, the photo behind the phone, and the cards in front. */
  .plane { position: absolute; pointer-events: none; will-change: translate; }
  .plane--photo { inset: -8%; }
  .plane--photo img {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(1) contrast(1.1) brightness(0.5); opacity: 0.55;
  }
  .plane--disc {
    width: min(460px, 78%); aspect-ratio: 1; border-radius: 50%;
    background: var(--lime); top: 50%; left: 50%; transform: translate(-50%, -50%);
  }
  .hero__bar {
    display: flex; justify-content: space-between; gap: 16px; padding: 16px 24px; background: var(--ink-raised); color: var(--slate-on-ink);
    min-height: 56px; align-items: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .js .hero__phone { animation: rise 1100ms var(--ease-expo) both 80ms; }
    .js .hero__toast { animation: pop 700ms var(--ease-out) both 700ms; }
    .js .hero__qr { animation: pop 700ms var(--ease-out) both 880ms; }
    .js .hero__title .line { animation: rise-sm 900ms var(--ease-expo) both; }
    .js .hero__title .line:nth-child(2) { animation-delay: 90ms; }
    @keyframes rise { from { opacity: 0; transform: translateY(48px); } }
    @keyframes rise-sm { from { opacity: 0; transform: translateY(24px); } }
    @keyframes pop { from { opacity: 0; transform: translateY(14px) scale(0.97); } }
  }

  @media (max-width: 1100px) {
    .hero__toast { left: 4%; }
    .hero__qr { right: 4%; }
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; min-height: 0; padding: 0 8px 8px; gap: 8px; }
    .hero__copy { padding: 36px 20px 24px; gap: 32px; }
    .hero__text { padding-top: 0; }
    .hero__title { font-size: min(76px, calc((100vw - 64px) / 7.1)); }
    .hero__sub { margin-top: 24px; font-size: 18px; }
    .hero__actions { margin-top: 28px; }
    .hero__cta { width: 100%; }
    .hero__actions .text-link { padding: 6px 0; }
    .hero__stage { min-height: 0; }
    .hero__scene { padding: 48px 16px 40px; }
    .hero__phone { width: min(300px, 74vw); }
    .hero__toast { top: 46%; left: 10px; padding: 10px 14px 10px 16px; font-size: 15px; }
    .hero__qr { bottom: 32px; right: 10px; padding: 10px 12px; font-size: 15px; }
    .plane--disc { width: min(340px, 84%); }
    .hero__qr-glyph { width: 44px; height: 44px; }
    .hero__bar { padding: 14px 16px; flex-direction: column; gap: 2px; align-items: flex-start; }
  }
</style>
