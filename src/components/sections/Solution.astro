---
import Stamps from '../ui/Stamps.astro';
// Zigzag top and bottom edges for the printed sheet.
const teeth = 26;
const depth = 12;
const top = Array.from({ length: teeth + 1 }, (_, i) => `${(i / teeth) * 100}% ${i % 2 ? depth : 0}px`);
const bottom = Array.from({ length: teeth + 1 }, (_, i) => `${100 - (i / teeth) * 100}% calc(100% - ${i % 2 ? depth : 0}px)`);
const clip = `polygon(${[...top, ...bottom].join(', ')})`;

const groups = [
  {
    name: 'מקום אחד',
    items: [
      { name: 'כרטיסים של עסקים משתתפים', value: 'ארנק אחד', note: 'בלי כרטיס נייר לכל עסק ובלי אפליקציה נפרדת לכל מועדון.' },
      { name: 'עסקים משתתפים בסביבה', value: 'לגלות', note: 'רואים אילו עסקים משתתפים ואיזו תוכנית מחכה בכל אחד מהם.' },
    ],
  },
  {
    name: 'צבירה פשוטה',
    items: [
      { name: 'סריקת קוד QR אחרי רכישה מזכה', value: 'חותמת או נקודות', note: 'בתהליך הצבירה שהעסק מגדיר בקופה.' },
    ],
  },
  {
    name: 'מעקב ומימוש',
    items: [
      { name: 'ההתקדמות בכל כרטיס', value: '7 מתוך 10', note: 'יודעים תמיד כמה חסר עד ההטבה הבאה.' },
      { name: 'מימוש הטבה', value: 'לפי כללי העסק', note: 'כשעומדים בתנאים שהעסק קבע, מציגים את ההטבה בקופה.' },
    ],
  },
];
---
<section class="solution on-ink" id="solution" aria-labelledby="solution-title">
  <div class="wrap solution__grid">
    <div class="sheet" style={`clip-path: ${clip}`} data-reveal>
      <h2 id="solution-title" class="head sheet__title">
        <span class="line">כל מה שצוברים,</span>
        <span class="line">במקום אחד.</span>
      </h2>
      <p class="sheet__intro">Perko מחברת את תוכניות הנאמנות של עסקים מקומיים שמשתתפים בה לחוויה דיגיטלית אחת. ככה זה אמור לעבוד:</p>
      {groups.map((g) => (
        <div class="sheet__group">
          <h3 class="sheet__group-name">{g.name}</h3>
          <dl>
            {g.items.map((it) => (
              <div class="sheet__item">
                <dt><span>{it.name}</span><span class="sheet__leader" aria-hidden="true"></span><b>{it.value}</b></dt>
                <dd>{it.note}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
      <p class="sheet__fine small">Perko בשלב גישה מוקדמת. התכונות כאן מתארות את המוצר כפי שהוא מתוכנן, והפרטים יתגבשו יחד עם העסקים הראשונים.</p>
    </div>

    <figure class="solution__fragment" data-reveal style="--i:2">
      <div class="card-detail" data-ui role="img" aria-label="המחשה של מסך כרטיס באפליקציה: כרטיס הקפה של בית קפה לדוגמה, 7 מתוך 10 חותמות, וכללי הצבירה שהעסק הגדיר">
        <div class="card-detail__head">
          <span class="ui-avatar ui-avatar--white">פ</span>
          <span><b>קפה פינה</b><span>בית קפה שכונתי · שם לדוגמה</span></span>
        </div>
        <p class="card-detail__count"><b>7</b> מתוך 10 חותמות</p>
        <Stamps type="stamps" total={10} current={7} class="ui-stamps--on-cobalt card-detail__stamps" />
        <p class="card-detail__next">עוד 3 ביקורים לקפה הפוך עלינו</p>
        <div class="card-detail__rules">
          <p class="card-detail__rules-title">הכללים של העסק הזה</p>
          <ul>
            <li><span>צבירה</span><b>חותמת על כל משקה חם</b></li>
            <li><span>הטבה</span><b>קפה הפוך אחרי 10 חותמות</b></li>
            <li><span>מימוש</span><b>בקופה, מול הצוות</b></li>
          </ul>
        </div>
      </div>
      <figcaption class="small">לכל עסק כללים משלו. בעסק אחד צוברים חותמות, באחר נקודות, וההטבה נקבעת על ידי העסק.</figcaption>
    </figure>
  </div>
</section>

<style>
  .solution { background: var(--ink); color: var(--white); padding-block: var(--gap-section); margin-top: calc(var(--gap-section) * 0.5); }
  .solution__grid { display: grid; grid-template-columns: 7fr 5fr; gap: clamp(40px, 6vw, 112px); align-items: center; }
  .sheet {
    background: var(--paper); color: var(--ink); padding: 64px clamp(28px, 4vw, 64px) 60px;
    max-width: 680px;
  }
  .sheet__title { margin-bottom: 20px; }
  .sheet__intro { color: var(--slate); max-width: 44ch; margin-bottom: 40px; }
  .sheet__group + .sheet__group { margin-top: 40px; }
  .sheet__group-name { font-size: 22px; font-weight: 800; margin-bottom: 14px; color: var(--cobalt-strong); }
  .sheet__item + .sheet__item { margin-top: 18px; }
  .sheet__item dt { display: flex; align-items: baseline; gap: 10px; font-size: 18px; font-weight: 500; }
  .sheet__item dt b { font-weight: 800; white-space: nowrap; }
  .sheet__leader { flex: 1; min-width: 24px; border-bottom: 4px dotted rgba(17, 21, 34, 0.32); transform: translateY(-5px); }
  .sheet__item dd { margin-top: 4px; color: var(--slate); font-size: 15px; max-width: 40ch; }
  .sheet__fine { margin-top: 44px; color: var(--slate); max-width: 52ch; }

  .solution__fragment { display: grid; gap: 20px; }
  .card-detail { background: var(--cobalt); color: var(--white); border-radius: var(--radius); padding: 32px; font-size: 15px; }
  .card-detail__head { display: flex; gap: 14px; align-items: center; }
  .card-detail__head .ui-avatar { font-size: 18px; width: 52px; height: 52px; border-radius: 16px; }
  .card-detail__head > span:last-child { display: grid; line-height: 1.3; }
  .card-detail__head b { font-size: 22px; }
  .card-detail__head span span { color: var(--slate-on-cobalt); font-size: 15px; }
  .card-detail__count { margin-top: 32px; font-size: 18px; }
  .card-detail__count b { font-size: 64px; font-weight: 800; letter-spacing: -0.04em; line-height: 1; margin-inline-end: 6px; }
  .card-detail__stamps { margin-top: 20px; font-size: 15px; gap: 12px; }
  .card-detail__next { margin-top: 18px; font-weight: 700; }
  .card-detail__rules { margin-top: 28px; background: var(--white); color: var(--ink); border-radius: 18px; padding: 18px 20px; }
  .card-detail__rules-title { font-weight: 800; margin-bottom: 8px; }
  .card-detail__rules li { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; font-size: 15px; }
  .card-detail__rules li span { color: var(--slate); }
  .solution__fragment figcaption { color: var(--slate-on-ink); max-width: 44ch; }

  @media (max-width: 960px) {
    .solution__grid { grid-template-columns: 1fr; }
    .sheet { padding: 48px 20px 44px; max-width: none; margin-inline: -8px; }
    .sheet__item dt { font-size: 18px; flex-wrap: wrap; }
    .sheet__item dt .sheet__leader { display: none; }
    .sheet__item dt b { color: var(--cobalt-strong); width: 100%; }
    .card-detail { padding: 24px 20px; }
  }
</style>
