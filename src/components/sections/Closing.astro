---
import Wordmark from '../Wordmark.astro';
import credits from '../../data/credits.json';
import { operator } from '../../data/legal';
const year = new Date().getFullYear();
---
<section class="closing on-ink" aria-labelledby="closing-title">
  <div class="wrap closing__inner">
    <h2 id="closing-title" class="display closing__title" data-reveal>
      <span class="line">פחות כרטיסים.</span>
      <span class="line">יותר סיבות לחזור.</span>
    </h2>
    <div class="closing__side" data-reveal style="--i:1">
      <p class="lead">ארנק אחד לכל ההטבות של העסקים בשכונה. אנחנו מתחילים עכשיו, עם העסקים שמצטרפים ראשונים.</p>
      <a class="btn btn--lime closing__btn" href="#join">
        הצטרפו בחינם
        <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6-6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>

  <footer class="footer">
    <div class="wrap">

      <div class="footer__row">
        <p>Perko · פלטפורמת נאמנות משותפת לעסקים מקומיים</p>
        <nav aria-label="ניווט תחתון">
          <ul>
            <li><a href="#how">איך זה עובד</a></li>
            <li><a href="#business">לעסקים</a></li>
            <li><a href="#demo">הדמיה</a></li>
            <li><a href="#faq">שאלות נפוצות</a></li>
            <li><a href="#join">הצטרפות</a></li>
          </ul>
        </nav>
        <p>© {year} Perko</p>
      </div>
      <div class="footer__legal">
        <ul>
          <li><a href="/privacy">מדיניות פרטיות</a></li>
          <li><a href="/terms">תנאי שימוש</a></li>
          <li><a href="/accessibility">הצהרת נגישות</a></li>
        </ul>
        <p>מופעל על ידי {operator.name}, {operator.city}. ליצירת קשר: <a href={`mailto:${operator.email}`}>{operator.email}</a></p>
      </div>
      <div class="footer__mark" aria-hidden="true"><Wordmark tone="lime" label={false} /></div>
      <p class="footer__credits">
        צילומי הרחובות והשווקים מ-Wikimedia Commons, להמחשת העולם של העסקים המקומיים. אף אחד מהעסקים שמופיעים בהם אינו שותף של Perko:
        {credits.map((c, i) => (
          <>
            {' '}<a href={c.page} rel="noopener" target="_blank">{c.title}</a>, {c.creator}, <a href={c.licenseUrl} rel="noopener license" target="_blank">{c.license}</a>{i < credits.length - 1 ? ';' : '.'}
          </>
        ))}
        {' '}התמונות נחתכו והומרו לפורמט webp.
      </p>
    </div>
  </footer>
</section>

<style>
  .closing { background: var(--ink); color: var(--white); padding-top: var(--gap-section); margin-top: 0; }
  .closing__inner { display: grid; grid-template-columns: 7fr 4fr; gap: 48px; align-items: end; }
  .closing__title { font-size: min(var(--t-display), calc((58vw - 80px) / 9.2)); }
  .closing__title .line { white-space: nowrap; }
  .closing__side { display: grid; gap: 28px; justify-items: start; }
  .closing__side .lead { color: var(--slate-on-ink); max-width: 30ch; }
  .closing__btn { min-height: 60px; padding: 0 32px; font-size: 18px; }

  .footer { margin-top: clamp(96px, 12vw, 176px); padding-bottom: 32px; }
  .footer__mark { direction: ltr; overflow: hidden; }
  .footer__mark :global(.wordmark) { font-size: clamp(110px, 25.6vw, 380px); line-height: 0.82; letter-spacing: -0.06em; display: flex; }
  .footer__row { margin-bottom: clamp(48px, 7vw, 96px); display: grid; grid-template-columns: 1fr auto 1fr; gap: 24px; align-items: center; font-size: 15px; color: var(--slate-on-ink); }
  .footer__row p:last-child { text-align: left; }
  .footer__row ul { display: flex; gap: 24px; flex-wrap: wrap; }
  .footer__row a { color: var(--white); text-decoration: none; }
  @media (hover: hover) and (pointer: fine) { .footer__row a:hover { text-decoration: underline; text-underline-offset: 0.25em; } }
  .footer__legal { margin-top: calc(-1 * clamp(24px, 3.5vw, 48px)); margin-bottom: clamp(48px, 7vw, 96px); display: grid; gap: 10px; font-size: 15px; color: var(--slate-on-ink); }
  .footer__legal ul { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .footer__legal a { color: var(--white); }
  .footer__credits { margin-top: 32px; font-size: 15px; line-height: 1.6; color: var(--slate-on-ink); max-width: 72ch; }
  .footer__credits a { color: var(--slate-on-ink); }

  @media (max-width: 960px) {
    .closing__inner { grid-template-columns: 1fr; }
    .closing__title { font-size: min(76px, calc((100vw - 48px) / 9.4)); }
    .footer__row { grid-template-columns: 1fr; gap: 10px; font-size: 15px; }
    .footer__row p:last-child { text-align: right; }
  }
</style>
