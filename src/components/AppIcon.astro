---
// App icon and favicon: a "p" whose bowl is a collected stamp.
interface Props { size?: number; class?: string }
const { size = 40, class: cls = '' } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <rect width="64" height="64" rx="16" fill="#435BFF" />
  <rect x="17" y="17" width="11" height="35" rx="5.5" fill="#fff" />
  <circle cx="35" cy="29" r="12.5" fill="#fff" />
</svg>
