---
import Stamps from '../ui/Stamps.astro';
import TabBar from './TabBar.astro';
import { businesses } from '../../data/businesses';
const [cafe, restaurant, shop] = businesses;
---
<div class="ui-app">
  <div class="ui-top">
    <p class="ui-hello">בוקר טוב, נועה</p>
    <p class="ui-title">הכרטיסים שלי</p>
  </div>

  <article class="ui-card ui-card--lime">
    <div class="ui-card__head">
      <span class="ui-avatar ui-avatar--white">{cafe.initial}</span>
      <span class="ui-card__names"><b>{cafe.name}</b><span>{cafe.program}</span></span>
      <span class="ui-count"><b>9</b>/{cafe.total}</span>
    </div>
    <Stamps type="stamps" total={cafe.total} current={9} class="ui-stamps--on-lime" />
    <p class="ui-card__foot">עוד חותמת אחת ל{cafe.reward.replace('עלינו', '').trim()} חינם</p>
  </article>

  <ul class="ui-list">
    <li class="ui-row">
      <span class="ui-avatar ui-avatar--ink">{restaurant.initial}</span>
      <span class="ui-row__body"><b>{restaurant.name}</b><span class="ui-bar"><i style="transform: scaleX(0.66)"></i></span></span>
      <span class="ui-row__val">4/6</span>
    </li>
    <li class="ui-row">
      <span class="ui-avatar ui-avatar--pale">{shop.initial}</span>
      <span class="ui-row__body"><b>{shop.name}</b><span class="ui-bar"><i style="transform: scaleX(0.6)"></i></span></span>
      <span class="ui-row__val">120 נק׳</span>
    </li>
  </ul>

  <p class="ui-subtitle">עסקים משתתפים בסביבה</p>
  <div class="ui-chips">
    <span class="ui-chip"><b>מאפיית הגפן</b><span>350 מ׳</span></span>
    <span class="ui-chip"><b>פרחי השדרה</b><span>600 מ׳</span></span>
  </div>

  <TabBar active="home" />
</div>
