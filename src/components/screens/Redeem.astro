---
import Stamps from '../ui/Stamps.astro';
---
<div class="ui-app ui-app--reward">
  <div class="ui-top">
    <p class="ui-hello">קפה פינה</p>
    <p class="ui-title">ההטבה מוכנה</p>
  </div>
  <article class="ui-reward">
    <Stamps type="stamps" total={10} current={10} class="ui-stamps--on-cobalt" />
    <p class="ui-reward__name">קפה הפוך עלינו</p>
    <p class="ui-reward__meta">10 מתוך 10 חותמות נאספו</p>
  </article>
  <div class="ui-redeem">
    <p class="ui-redeem__label">מציגים את המסך לצוות בקופה</p>
    <span class="ui-redeem__btn">מימוש ההטבה</span>
    <p class="ui-redeem__note">אחרי המימוש מתחיל כרטיס חדש</p>
  </div>
</div>
