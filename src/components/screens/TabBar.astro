---
import QrGlyph from '../ui/QrGlyph.astro';
interface Props { active?: 'home' | 'discover' | 'rewards' }
const { active = 'home' } = Astro.props;
---
<div class="ui-tabs" aria-hidden="true">
  <span class:list={['ui-tab', { 'is-active': active === 'home' }]}><i class="ui-ico ui-ico--home"></i>כרטיסים</span>
  <span class:list={['ui-tab', { 'is-active': active === 'discover' }]}><i class="ui-ico ui-ico--pin"></i>גילוי</span>
  <span class="ui-tab ui-tab--scan"><span class="ui-scan-btn"><QrGlyph /></span>סריקה</span>
  <span class:list={['ui-tab', { 'is-active': active === 'rewards' }]}><i class="ui-ico ui-ico--gift"></i>הטבות</span>
  <span class="ui-tab"><i class="ui-ico ui-ico--user"></i>פרופיל</span>
</div>
