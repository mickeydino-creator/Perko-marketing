---
import TabBar from './TabBar.astro';
---
<div class="ui-app">
  <div class="ui-top">
    <p class="ui-title">גילוי</p>
  </div>
  <div class="ui-search"><i class="ui-ico ui-ico--search"></i>חיפוש עסקים משתתפים</div>
  <div class="ui-filters">
    <span class="is-on">הכל</span><span>קפה</span><span>אוכל</span><span>חנויות</span>
  </div>
  <ul class="ui-places">
    <li class="ui-place is-focus">
      <span class="ui-avatar ui-avatar--cobalt">מ</span>
      <span class="ui-place__body"><b>מאפיית הגפן</b><span>מאפייה · 350 מ׳</span><em>8 חותמות = מאפה לבחירה</em></span>
      <span class="ui-add">הוספה</span>
    </li>
    <li class="ui-place">
      <span class="ui-avatar ui-avatar--ink">ז</span>
      <span class="ui-place__body"><b>זעתר</b><span>מסעדה · 450 מ׳</span><em>6 חותמות = קינוח לשניים</em></span>
      <span class="ui-added">בארנק</span>
    </li>
    <li class="ui-place">
      <span class="ui-avatar ui-avatar--pale">פ</span>
      <span class="ui-place__body"><b>פרחי השדרה</b><span>חנות פרחים · 600 מ׳</span><em>5 חותמות = זר קטן</em></span>
      <span class="ui-add">הוספה</span>
    </li>
    <li class="ui-place">
      <span class="ui-avatar ui-avatar--pale">ד</span>
      <span class="ui-place__body"><b>דפדוף</b><span>ספרים · 800 מ׳</span><em>200 נק׳ = שובר 30 ₪</em></span>
      <span class="ui-added">בארנק</span>
    </li>
  </ul>
  <TabBar active="discover" />
</div>
