# The business interest form posts to /api/join (api/join.ts), a Vercel Function that emails each sign-up.
# Set these in Vercel > Project > Settings > Environment Variables (server-side, not PUBLIC_):
# RESEND_API_KEY=
# JOIN_TO_EMAIL=
# JOIN_FROM_EMAIL=Perko <hello@getperko.com>

# Optional: post the form somewhere else instead of /api/join.
PUBLIC_FORM_ENDPOINT=
